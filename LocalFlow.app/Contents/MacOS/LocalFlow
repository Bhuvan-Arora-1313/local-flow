#!/bin/zsh
# Double-clicking LocalFlow.app runs this. It hands off to the `localflow` control
# script (single-instance lock, offline env, launchd-or-nohup) and exits.
HERE="${0:A:h:h:h:h}"          # …/LocalFlow.app/Contents/MacOS/ -> project root

if pgrep -f "${HERE}/flow.py" >/dev/null 2>&1; then
  osascript -e 'display notification "Already running — look for “LF” in the menu bar." with title "LocalFlow"' >/dev/null 2>&1
  exit 0
fi

"${HERE}/localflow" start >/dev/null 2>&1
osascript -e 'display notification "Starting… “LF” will appear in the menu bar in a moment." with title "LocalFlow"' >/dev/null 2>&1

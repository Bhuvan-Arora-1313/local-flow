#!/bin/zsh
# Bundle executable. Launched by `open LocalFlow.app` or the LaunchAgent.
# It exec's Python directly (in-process) so rumps' menu-bar item initialises
# properly — handing off to a detached process does NOT create the status item.
export PYTHONUNBUFFERED=1

CANDIDATES=(
  "__LOCALFLOW_HOME__"
  "${0:A:h:h:h:h}"
  "${HOME}/localflow"
  "${HOME}/local-flow"
)
HERE=""
for c in $CANDIDATES; do
  [[ -f "$c/flow.py" ]] && HERE="$c" && break
done
[[ -n "$HERE" ]] || { osascript -e 'display alert "LocalFlow" message "Project folder not found — re-run ./install.sh."'; exit 1; }

LOG="${HERE}/localflow.log"
PY="$(cat "${HERE}/.python-path" 2>/dev/null)"
[[ -x "$PY" ]] || PY="${HOME}/miniconda3/envs/flow/bin/python"
[[ -x "$PY" ]] || PY="$(command -v python3)"

[[ -f "$LOG" && $(wc -c <"$LOG") -gt 1000000 ]] && : > "$LOG"
if ls "${HOME}/.cache/huggingface/hub/models--mlx-community--parakeet-tdt-0.6b-v3/snapshots/"*/config.json >/dev/null 2>&1; then
  export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
fi

cd "$HERE" || exit 1
exec "$PY" "${HERE}/flow.py" >>"$LOG" 2>&1

#!/bin/zsh
# LocalFlow control:  localflow {start|stop|restart|status|logs|install|uninstall}
HERE="${0:A:h}"                       # resolves symlinks -> real project dir
FLOW="${HERE}/flow.py"
LOG="${HERE}/localflow.log"
PLIST="${HOME}/Library/LaunchAgents/com.localflow.dictation.plist"
LABEL="com.localflow.dictation"

is_running() { pgrep -f "${FLOW}" >/dev/null 2>&1; }
running_pids() { pgrep -f "${FLOW}" | tr '\n' ' '; }
installed()  { [[ -f "$PLIST" ]]; }

py() {
  local p
  p="$(cat "$HERE/.python-path" 2>/dev/null)"
  [[ -x "$p" ]] || p="${HOME}/miniconda3/envs/flow/bin/python"
  [[ -x "$p" ]] || p="$(command -v python3)"
  echo "$p"
}

start() {
  if is_running; then echo "LocalFlow is already running (pid $(running_pids))."; return; fi

  export PYTHONUNBUFFERED=1
  if ls "${HOME}/.cache/huggingface/hub/models--mlx-community--parakeet-tdt-0.6b-v3/snapshots/"*/config.json >/dev/null 2>&1; then
    export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
  fi
  [[ -f "${LOG}" && $(wc -c <"${LOG}") -gt 1000000 ]] && : > "${LOG}"

  if installed; then
    local D="gui/$(id -u)"
    launchctl bootstrap "$D" "$PLIST" 2>/dev/null   # if not loaded yet
    launchctl enable "$D/${LABEL}" 2>/dev/null
    launchctl kickstart -k "$D/${LABEL}" 2>/dev/null # (re)start now
  else
    # Launch the .app through LaunchServices so the menu-bar item registers.
    open "${HERE}/LocalFlow.app"
  fi

  local i
  for i in {1..25}; do is_running && break; sleep 1; done
  if is_running; then
    echo "LocalFlow started (pid $(running_pids))."
    echo "Look for 'LF' near the right end of the menu bar."
  else
    echo "Start failed. Last log lines:"; tail -n 15 "$LOG"
  fi
}

stop() {
  installed && { launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null \
                 || launchctl unload "$PLIST" 2>/dev/null; }
  pkill -f "${FLOW}" 2>/dev/null
  sleep 1
  pkill -9 -f "${FLOW}" 2>/dev/null
  is_running && echo "Still running (pid $(running_pids))." || echo "LocalFlow stopped."
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  status)
    if is_running; then
      echo "running (pid $(running_pids))"
      installed && echo "mode: starts at login" || echo "mode: manual"
    else
      echo "stopped"
      installed && echo "mode: will start at next login"
    fi ;;
  logs)      tail -n 40 -f "$LOG" ;;
  install)   "${HERE}/install.sh" ;;
  uninstall) "${HERE}/uninstall.sh" ;;
  *) echo "usage: localflow {start|stop|restart|status|logs|install|uninstall}" ;;
esac
exit 0

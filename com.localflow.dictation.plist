<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.localflow.dictation</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYBIN__</string>
        <string>__LOCALFLOW_HOME__/flow.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__LOCALFLOW_HOME__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>HF_HUB_OFFLINE</key>
        <string>1</string>
        <key>TRANSFORMERS_OFFLINE</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__LOCALFLOW_HOME__/localflow.log</string>
    <key>StandardErrorPath</key>
    <string>__LOCALFLOW_HOME__/localflow.log</string>
</dict>
</plist>

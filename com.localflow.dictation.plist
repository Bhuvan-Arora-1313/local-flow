<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.localflow.dictation</string>

    <!-- The bundle executable is a real compiled app (embeds Python), so launchd
         can run it directly; LimitLoadToSessionType=Aqua puts it in the GUI
         session so its menu-bar item shows. -->
    <key>ProgramArguments</key>
    <array>
        <string>__APP_EXE__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <!-- Restart only if it crashes (non-zero / killed) -- NOT after a clean
         exit, so menu-bar Quit (NSApp terminate, exit 0) actually stays quit
         until next login or `localflow start`. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__LOCALFLOW_HOME__/localflow.log</string>
    <key>StandardErrorPath</key>
    <string>__LOCALFLOW_HOME__/localflow.log</string>
</dict>
</plist>

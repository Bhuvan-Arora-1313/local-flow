<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          Shows the floating island wherever a text field is focused, across
          apps, without the user switching keyboards. Started exactly once,
          from MainActivity while it is visible: the only moment this app
          creates a microphone-type foreground service. See
          DictationOverlayService's header comment for why.
        -->
        <service
            android:name=".DictationOverlayService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".LocalFlowAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
